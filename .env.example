# Copia este archivo como .env.local y llena los valores. En Vercel: Settings → Environment Variables.

# Supabase (públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SECRETA, solo servidor): Project Settings → API Keys → Secret key (sb_secret_…) o service_role.
# La usan las rutas /api/stripe/* para activar licencias y emitir recibos.
SUPABASE_SECRET_KEY=

# Stripe — Dashboard → Developers → API keys. Pruebas: pk_test_/sk_test_. Producción: pk_live_/sk_live_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Firma del webhook (whsec_…). Local: la imprime `stripe listen`. Vercel: la del endpoint en el Dashboard.
STRIPE_WEBHOOK_SECRET=
# Tasa "IVA 16 % incluido" (txr_…): la imprime `node --env-file=.env.local scripts/stripe-setup.mjs`. Opcional.
STRIPE_TAX_RATE_IVA=

# Dominio público (enlaces de invitación y correos desde la app nativa). Por defecto https://www.entrenamente.io
NEXT_PUBLIC_SITE_URL=https://www.entrenamente.io
